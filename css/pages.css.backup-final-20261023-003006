/* =========================================================
   PÁGINAS EDITORIALES — GÉNESIS
   ========================================================= */

.editorial-page {
  background: #f5f1ea;
  color: #171916;
}

.editorial-main {
  overflow: hidden;
}

.editorial-hero {
  min-height: min(76vh, 760px);
  position: relative;
  display: flex;
  align-items: flex-end;
  padding: clamp(36px, 7vw, 100px);
  isolation: isolate;
  background: #20231e;
  color: #f8f4ed;
}

.editorial-hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: -2;
  background:
    linear-gradient(90deg, rgba(13, 16, 13, .76), rgba(13, 16, 13, .08)),
    linear-gradient(0deg, rgba(13, 16, 13, .45), transparent 65%),
    url("../assets/images/interni-genesis.jpg") center / cover no-repeat;
}

.editorial-hero-content {
  max-width: 790px;
}

.editorial-kicker {
  display: block;
  margin-bottom: 22px;
  font-size: .72rem;
  letter-spacing: .24em;
  text-transform: uppercase;
}

.editorial-hero h1 {
  max-width: 760px;
  margin: 0;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(3.6rem, 9vw, 8.4rem);
  font-weight: 400;
  line-height: .88;
  letter-spacing: -.045em;
}

.editorial-hero p {
  max-width: 490px;
  margin: 26px 0 0;
  font-size: clamp(1rem, 1.5vw, 1.2rem);
  line-height: 1.8;
}

.editorial-section {
  width: min(1120px, calc(100% - 48px));
  margin: 0 auto;
  padding: clamp(70px, 10vw, 135px) 0;
}

.editorial-two-col {
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  gap: clamp(35px, 8vw, 120px);
  align-items: start;
}

.editorial-overline {
  margin: 0 0 18px;
  font-size: .7rem;
  letter-spacing: .2em;
  text-transform: uppercase;
}

.editorial-section h2 {
  margin: 0;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(2.6rem, 5vw, 5rem);
  font-weight: 400;
  line-height: .98;
  letter-spacing: -.035em;
}

.editorial-copy p {
  margin: 0 0 20px;
  font-size: 1rem;
  line-height: 1.95;
}

.editorial-quote {
  background: #1b211b;
  color: #f5f1ea;
  padding: clamp(36px, 7vw, 92px) 24px;
  text-align: center;
}

.editorial-quote-inner {
  width: min(850px, 100%);
  margin: 0 auto;
}

.editorial-quote img {
  display: block;
  width: min(100%, 640px);
  max-height: 430px;
  object-fit: cover;
  margin: 0 auto 34px;
}

.editorial-quote blockquote {
  margin: 0 auto;
  max-width: 780px;
  font-family: "Cormorant Garamond", Georgia, serif;
  font-size: clamp(2rem, 5vw, 4.2rem);
  line-height: 1.1;
}

.editorial-quote p {
  max-width: 620px;
  margin: 25px auto 0;
  line-height: 1.8;
  opacity: .82;
}

.editorial-end {
  text-align: center;
}

.editorial-end p {
  max-width: 650px;
  margin: 24px auto 0;
  line-height: 1.9;
}

.editorial-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  margin-top: 28px;
  padding: 13px 24px;
  border: 1px solid currentColor;
  color: inherit;
  text-decoration: none;
  font-size: .75rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  transition: background .2s ease, color .2s ease;
}

.editorial-cta:hover {
  background: #1b211b;
  color: #f5f1ea;
}

.visit-layout {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: clamp(36px, 7vw, 100px);
  align-items: center;
}

.visit-photo {
  min-height: 480px;
  background: #d9d2c6 url("../assets/images/location.jpeg") center / cover no-repeat;
}

.visit-address {
  margin: 28px 0;
  font-size: 1.05rem;
  line-height: 1.9;
}

.visit-map-link {
  background: #1b211b;
  color: #f5f1ea;
}

.visit-map-link:hover {
  background: transparent;
  color: #1b211b;
}

@media (max-width: 768px) {
  .editorial-hero {
    min-height: 72svh;
    padding: 32px 24px 42px;
  }

  .editorial-hero::before {
    background:
      linear-gradient(0deg, rgba(13, 16, 13, .82), rgba(13, 16, 13, .06) 90%),
      url("../assets/images/interni-genesis-02.png") center / cover no-repeat;
  }

  .editorial-hero h1 {
    font-size: clamp(3.5rem, 17vw, 6rem);
  }

  .editorial-section {
    width: calc(100% - 44px);
    padding: 72px 0;
  }

  .editorial-two-col,
  .visit-layout {
    grid-template-columns: 1fr;
    gap: 28px;
  }

  .editorial-quote {
    padding: 56px 22px;
  }

  .visit-photo {
    min-height: 340px;
    order: -1;
  }
}

/* Navigación propia de las páginas editoriales */
.pages-menu-toggle {
  display: none;
  border: 1px solid currentColor;
  background: transparent;
  color: inherit;
  padding: 10px 14px;
  font: inherit;
  cursor: pointer;
}

.pages-mobile-nav {
  display: none;
}

@media (max-width: 768px) {
  body.editorial-page .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  body.editorial-page .site-header .desktop-nav {
    display: none;
  }

  .pages-menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .pages-mobile-nav.is-open {
    display: flex;
    flex-direction: column;
    gap: 0;
    padding: 8px 22px 20px;
    background: #f5f1ea;
  }

  .pages-mobile-nav a {
    padding: 15px 0;
    border-bottom: 1px solid rgba(23, 25, 22, .15);
    color: inherit;
    text-decoration: none;
  }
}


/* Galleria fotografica — pagina Cómo llegar */
.editorial-page .visit-gallery {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 14px;
  align-items: stretch;
  min-width: 0;
}

.editorial-page .visit-photo {
  display: block;
  width: 100%;
  min-width: 0;
  height: clamp(300px, 38vw, 490px);
  min-height: 0;
  background: #d9d2c6;
  object-fit: cover;
}

.editorial-page .visit-photo-portrait {
  object-position: center 35%;
}

.editorial-page .visit-photo-wide {
  object-position: center;
}

@media (max-width: 768px) {
  .editorial-page .visit-gallery {
    grid-template-columns: 1fr;
    gap: 18px;
  }

  .editorial-page .visit-photo {
    height: auto;
    max-height: none;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .editorial-page .visit-photo-portrait {
    aspect-ratio: 3 / 4;
    object-position: center 35%;
  }
}

/* Link Privacy e cookie: dimensioni coerenti nelle pagine editoriali */
.editorial-page .footer-bottom-actions {
  gap: 16px;
}

.editorial-page .footer-legal-link {
  display: inline-flex;
  width: auto;
  min-width: 0;
  padding: 0;
  font-family: inherit;
  font-size: 12px;
  font-weight: 400;
  line-height: 1.4;
  text-transform: none;
  letter-spacing: normal;
  white-space: nowrap;
}

@media (max-width: 680px) {
  .editorial-page .footer-legal-link {
    font-size: 11px;
  }

  .editorial-page .footer-bottom-actions {
    gap: 12px;
  }
}

/* Hero dedicato alla pagina Dove siamo */
.como-llegar-page .editorial-hero {
  align-items: flex-end;
}

.como-llegar-page .editorial-hero::before {
  background:
    linear-gradient(90deg, rgba(13, 16, 13, .72) 0%, rgba(13, 16, 13, .30) 48%, rgba(13, 16, 13, .08) 100%),
    linear-gradient(0deg, rgba(13, 16, 13, .42), transparent 65%),
    url("../assets/images/dovesiamo2.jpg") center / cover no-repeat;
}

@media (max-width: 768px) {
  .como-llegar-page .editorial-hero {
    align-items: flex-start;
    justify-content: flex-start;
    padding: 34px 24px;
    min-height: 72svh;
  }

  .como-llegar-page .editorial-hero-content {
    width: 100%;
    max-width: 520px;
    margin: 0;
    text-align: left;
  }

  .como-llegar-page .editorial-hero::before {
    background:
      linear-gradient(180deg, rgba(13, 16, 13, .68) 0%, rgba(13, 16, 13, .24) 48%, rgba(13, 16, 13, .10) 100%),
      url("../assets/images/dovesiamo.jpg") center 34% / cover no-repeat;
  }
}


/* Correzioni finali — hero mobile e seconda foto */
@media (max-width: 768px) {
  .como-llegar-page .editorial-hero {
    align-items: flex-start;
    padding-top: clamp(125px, 24vw, 165px);
    padding-bottom: 36px;
    min-height: 76svh;
  }

  .como-llegar-page .editorial-hero-content {
    position: relative;
    z-index: 1;
    max-width: 100%;
    text-align: left;
  }

  .como-llegar-page .editorial-hero .editorial-kicker {
    margin-bottom: 16px;
    font-size: .7rem;
    line-height: 1.5;
    text-shadow: 0 1px 12px rgba(0, 0, 0, .65);
  }

  .como-llegar-page .editorial-hero h1,
  .como-llegar-page .editorial-hero p {
    text-shadow: 0 2px 18px rgba(0, 0, 0, .65);
  }
}

/* La seconda foto deve mostrare più contenuto su desktop */
@media (min-width: 769px) {
  .editorial-page .visit-photo-wide {
    object-fit: contain;
    background: #e8e1d6;
  }
}


