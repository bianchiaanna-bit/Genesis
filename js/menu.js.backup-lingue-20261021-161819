/* =======================================================
   RENDER MENU
   ======================================================= */

const renderMenu = (dishes, notes) => {
  if (!Array.isArray(dishes) || !dishes.length) {
    if (menuContent) {
      menuContent.innerHTML = `
        <div class="menu-empty">
          <p data-i18n="menuPage.empty">
            La carta è in preparazione.
          </p>
        </div>
      `;
    }

    translatePage();
    return;
  }

  const categories = [];

  dishes.forEach((dish) => {
    const slug =
      dish.category_slug ||
      `categoria-${dish.category_id}`;

    let category = categories.find(
      (item) => item.slug === slug
    );

    if (!category) {
      category = {
        id: dish.category_id,
        slug,
        name: dish.category_name_es || "Carta",
        dishes: []
      };

      categories.push(category);
    }

    category.dishes.push(dish);
  });

  categories.forEach((category) => {
    category.group = classifyCategory(category);
  });

  const groups = {
    salato: [],
    dolce: [],
    platos: [],
    bevande: []
  };

  categories.forEach((category) => {
    if (groups[category.group]) {
      groups[category.group].push(category);
    } else {
      groups.salato.push(category);
    }
  });

  if (menuGroups) {
    menuGroups.innerHTML = Object.keys(groups)
      .filter((group) => groups[group].length)
      .map((group) => {
        const definition = groupDefinitions[group];

        return `
          <button
            class="menu-group-link"
            type="button"
            data-group="${group}"
          >
            ${escapeHtml(
              translations[currentLanguage][definition.key]
            )}
          </button>
        `;
      })
      .join("");
  }

  if (menuCategories) {
    menuCategories.innerHTML = Object.keys(groups)
      .filter((group) => groups[group].length)
      .flatMap((group) => groups[group])
      .map((category) => `
        <button
          class="menu-category-link"
          type="button"
          data-target="${escapeHtml(category.slug)}"
        >
          ${escapeHtml(getCategoryName(category))}
        </button>
      `)
      .join("");
  }

  let globalIndex = 0;

  if (menuContent) {
    menuContent.innerHTML = Object.keys(groups)
      .filter((group) => groups[group].length)
      .map((group) => {
        const definition = groupDefinitions[group];

        const groupTitle =
          translations[currentLanguage][definition.key];

        const categoryHtml = groups[group]
          .map((category) => {
            globalIndex++;

            const categoryNotes = Array.isArray(notes)
              ? notes.filter(
                  (note) =>
                    Number(note.category_id) ===
                    Number(category.id)
                )
              : [];

            const noteText = categoryNotes
              .map((note) => note.text_es)
              .filter(Boolean)
              .join(" · ");

            const dishesHtml = category.dishes
              .map((dish) => renderDish(dish))
              .join("");

            return `
              <section
                id="${escapeHtml(category.slug)}"
                class="menu-category"
                data-menu-group="${group}"
              >
                <div class="menu-category-heading">
                  <div>
                    <span class="menu-category-number">
                      ${String(globalIndex).padStart(2, "0")}
                    </span>

                    <h2 class="menu-category-title">
                      ${escapeHtml(getCategoryName(category))}
                    </h2>
                  </div>

                  ${
                    noteText
                      ? `
                        <p class="menu-category-note">
                          ${escapeHtml(noteText)}
                        </p>
                      `
                      : ""
                  }
                </div>

                <div class="menu-dishes">
                  ${dishesHtml}
                </div>
              </section>
            `;
          })
          .join("");

        return `
          <div
            class="menu-group"
            id="menu-group-${group}"
            data-menu-group="${group}"
          >
            <div class="menu-group-heading">
              <span class="menu-group-kicker">
                ${String(definition.order).padStart(2, "0")}
              </span>

              <h2 class="menu-group-title">
                ${escapeHtml(groupTitle)}
              </h2>
            </div>

            <div class="menu-group-content">
              ${categoryHtml}
            </div>
          </div>
        `;
      })
      .join("");
  }

  initCategoryNavigation();
  initGroupNavigation();
  initCategoryObserver();
  renderMenuInfo();
};


/* =======================================================
   RENDER SINGOLO PIATTO
   ======================================================= */

const renderDish = (dish) => {
  const name = escapeHtml(dish.name_es);
  const description = escapeHtml(
    dish[`description_${currentLanguage}`] || dish.description_es || ""
  );
  const allergens = escapeHtml(dish.allergens);

  const price = formatPrice(
    dish.price_cents,
    dish.price_max_cents
  );

  const image = imageUrl(dish.image_key);

  const badges = [];

  if (Number(dish.vegetarian) === 1) {
    badges.push(
      translations[currentLanguage]["menuPage.vegetarian"]
    );
  }

  if (Number(dish.vegan) === 1) {
    badges.push(
      translations[currentLanguage]["menuPage.vegan"]
    );
  }

  const badgesHtml = badges.length
    ? `
      <div class="menu-dish-badges">
        ${badges.map((badge) => `
          <span class="menu-dish-badge">
            ${escapeHtml(badge)}
          </span>
        `).join("")}
      </div>
    `
    : "";

  const allergensHtml = allergens
    ? `
      <p class="menu-dish-allergens">
        ${allergens}
      </p>
    `
    : "";

  const descriptionHtml = description
    ? `
      <p class="menu-dish-description">
        ${description}
      </p>
    `
    : "";

  if (image) {
    return `
      <article class="menu-dish menu-dish--image">
        <div class="menu-dish-image">
          <img
            src="${image}"
            alt="${name}"
            loading="lazy"
          >
        </div>

        <div class="menu-dish-main">
          <h3 class="menu-dish-name">${name}</h3>
          ${descriptionHtml}
          ${allergensHtml}
          ${badgesHtml}
        </div>

        <div class="menu-dish-price">${price}</div>
      </article>
    `;
  }

  return `
    <article class="menu-dish">
      <div class="menu-dish-main">
        <h3 class="menu-dish-name">${name}</h3>
        ${descriptionHtml}
        ${allergensHtml}
        ${badgesHtml}
      </div>

      <div class="menu-dish-price">${price}</div>
    </article>
  `;
};


/* =======================================================
   NAVIGAZIONE CATEGORIE
   ======================================================= */

const initCategoryNavigation = () => {
  const buttons =
    document.querySelectorAll(".menu-category-link");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const target =
        document.getElementById(button.dataset.target);

      if (!target) {
        return;
      }

      const offset = 105;

      const top =
        target.getBoundingClientRect().top +
        window.scrollY -
        offset;

      window.scrollTo({
        top,
        behavior: "smooth"
      });

      buttons.forEach((item) => {
        item.classList.remove("is-active");
      });

      button.classList.add("is-active");
    });
  });

  if (buttons[0]) {
    buttons[0].classList.add("is-active");
  }
};


/* =======================================================
   NAVIGAZIONE MACRO-GRUPPI
   ======================================================= */

const initGroupNavigation = () => {
  const buttons =
    document.querySelectorAll(".menu-group-link");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const group = button.dataset.group;

      const target =
        document.getElementById(`menu-group-${group}`);

      if (!target) {
        return;
      }

      const offset = 100;

      const top =
        target.getBoundingClientRect().top +
        window.scrollY -
        offset;

      window.scrollTo({
        top,
        behavior: "smooth"
      });

      buttons.forEach((item) => {
        item.classList.remove("is-active");
      });

      button.classList.add("is-active");
    });
  });

  if (buttons[0]) {
    buttons[0].classList.add("is-active");
  }
};


/* =======================================================
   RILEVAMENTO CATEGORIA DURANTE LO SCROLL
   ======================================================= */

let categoryObserver = null;

const initCategoryObserver = () => {
  if (categoryObserver) {
    categoryObserver.disconnect();
  }

  const sections =
    document.querySelectorAll(".menu-category");

  const buttons =
    document.querySelectorAll(".menu-category-link");

  if (!sections.length) {
    return;
  }

  categoryObserver = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) {
          return;
        }

        buttons.forEach((button) => {
          button.classList.toggle(
            "is-active",
            button.dataset.target === entry.target.id
          );
        });
      });
    },
    {
      rootMargin: "-20% 0px -65% 0px",
      threshold: 0
    }
  );

  sections.forEach((section) => {
    categoryObserver.observe(section);
  });
};


/* =======================================================
   CARICAMENTO MENU
   ======================================================= */

const loadMenu = async () => {
  try {
    const response = await fetch(`${API_URL}/api/menu`);

    if (!response.ok) {
      throw new Error("Menu request failed");
    }

    const data = await response.json();

    menuData = data;

    renderMenu(
      data.dishes || [],
      data.notes || []
    );

    renderMenuInfo();

    if (menuError) {
      menuError.classList.add("hidden");
    }
  } catch (error) {
    console.error("Errore caricamento menu:", error);

    if (menuContent) {
      menuContent.innerHTML = "";
    }

    if (menuError) {
      menuError.classList.remove("hidden");
    }

    // La sezione informativa resta visibile con i dati di riserva.
    renderMenuInfo();
  }
};


/* =======================================================
   AVVIO
   ======================================================= */

initLanguageSwitcher();
loadMenu();


/* =====================================================
   GÉNESIS — PRIVACIDAD Y COOKIES (MENU.HTML)
   ===================================================== */

(() => {
  const modal = document.getElementById("legal-modal");
  const banner = document.getElementById("cookie-banner");

  if (!modal) {
    console.error("Privacy: elemento #legal-modal non trovato.");
    return;
  }

  const dialog = modal.querySelector(".legal-dialog");

  if (!dialog) {
    console.error("Privacy: elemento .legal-dialog non trovato.");
    return;
  }

  let previousFocus = null;

  // APERTURA DEL PANNELLO
  function openLegal(event) {
    event?.preventDefault();

    if (modal.getAttribute("aria-hidden") === "false") return;

    previousFocus = document.activeElement;

    modal.removeAttribute("inert");
    modal.setAttribute("aria-hidden", "false");

    document.body.classList.add("legal-modal-open");

    const content = modal.querySelector(".legal-content");
    if (content) content.scrollTop = 0;

    requestAnimationFrame(() => dialog.focus());
  }

  // CHIUSURA DEL PANNELLO
  function closeLegal(event) {
    event?.preventDefault();

    if (modal.getAttribute("aria-hidden") !== "false") return;

    modal.setAttribute("aria-hidden", "true");
    modal.setAttribute("inert", "");

    document.body.classList.remove("legal-modal-open");

    if (
      previousFocus &&
      typeof previousFocus.focus === "function" &&
      document.contains(previousFocus)
    ) {
      previousFocus.focus();
    }

    previousFocus = null;
  }

  // LINK "PRIVACIDAD Y COOKIES"
  document.querySelectorAll("[data-open-legal]").forEach(element => {
    element.addEventListener("click", openLegal);
  });

  // X E SFONDO OSCURO
  modal.querySelectorAll("[data-close-legal]").forEach(element => {
    element.addEventListener("click", closeLegal);
  });

  // TASTO ESC
  document.addEventListener("keydown", event => {
    if (
      event.key === "Escape" &&
      modal.getAttribute("aria-hidden") === "false"
    ) {
      closeLegal(event);
    }
  });

  // APERTURA DELLE PREFERENZE COOKIE
  modal.querySelectorAll("[data-open-cookie-settings]").forEach(element => {
    element.addEventListener("click", event => {
      event.preventDefault();
      closeLegal();

      if (banner) {
        banner.hidden = false;

        requestAnimationFrame(() => {
          document.getElementById("cookie-accept")?.focus();
        });
      }
    });
  });

  // STATO INIZIALE
  modal.setAttribute("aria-hidden", "true");
  modal.setAttribute("inert", "");
})();
