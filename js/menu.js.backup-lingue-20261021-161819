/* =======================================================
   HELPER GENERALI
   ======================================================= */

const escapeHtml = (value) => {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
};


const normalizeText = (value) => {
  return String(value || "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .trim();
};


const getCurrentLanguage = () => {
  const saved =
    localStorage.getItem("genesis-language");

  if (
    saved === "es" ||
    saved === "en" ||
    saved === "it"
  ) {
    return saved;
  }

  return "es";
};


let currentLanguage = getCurrentLanguage();


/* =======================================================
   PREZZI
   ======================================================= */

const formatPrice = (priceCents, maxCents) => {
  const price = Number(priceCents);
  const max = Number(maxCents);

  if (!Number.isFinite(price) || price < 0) {
    return "";
  }

  const format = (cents) =>
    (cents / 100).toFixed(2).replace(".", ",");

  if (Number.isFinite(max) && max > price) {
    return `€ ${format(price)} – € ${format(max)}`;
  }

  return `€ ${format(price)}`;
};


const formatExtraPrice = (value) => {
  const price = Number(value);

  if (!Number.isFinite(price) || price < 0) {
    return "";
  }

  return `+${price.toFixed(2).replace(".", ",")} €`;
};


