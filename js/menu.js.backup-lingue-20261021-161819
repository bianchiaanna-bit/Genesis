/* =======================================================
   GRUPPI MENU
   ======================================================= */

const groupDefinitions = {
  salato: {
    key: "menuPage.group.salato",
    order: 1
  },

  dolce: {
    key: "menuPage.group.dolce",
    order: 2
  },

  platos: {
    key: "menuPage.group.platos",
    order: 3
  },

  bevande: {
    key: "menuPage.group.bevande",
    order: 4
  }
};


const classifyCategory = (category) => {
  const name = normalizeText(category.name);
  const slug = normalizeText(category.slug);

  if (
    name.includes("platos") ||
    slug.includes("platos")
  ) {
    return "platos";
  }

  if (
    name.includes("cafe") ||
    name.includes("smoothie") ||
    name.includes("zumo") ||
    name.includes("milkshake") ||
    slug.includes("cafe") ||
    slug.includes("smoothie") ||
    slug.includes("zumo") ||
    slug.includes("milkshake")
  ) {
    return "bevande";
  }

  if (
    name.includes("dulce") ||
    name.includes("sweet") ||
    slug.includes("dulce") ||
    slug.includes("sweet") ||
    name.includes("bowl") ||
    slug.includes("bowl")
  ) {
    return "dolce";
  }

  if (
    name.includes("pancakes dulces") ||
    slug.includes("pancakes-dulces")
  ) {
    return "dolce";
  }

  if (
    name.includes("brioche dulce") ||
    slug.includes("brioche-dulce")
  ) {
    return "dolce";
  }

  if (
    name.includes("croissant") ||
    name.includes("gofre") ||
    slug.includes("croissant") ||
    slug.includes("gofre")
  ) {
    if (
      slug.includes("dulce") ||
      slug.includes("sweet")
    ) {
      return "dolce";
    }

    return "salato";
  }

  return "salato";
};


/* =======================================================
   NOME CATEGORIA TRADOTTO
   ======================================================= */

const getCategoryName = (category) => {
  const original = String(category.name || "Carta");

  if (currentLanguage === "es") {
    return original;
  }

  const normalized = normalizeText(original);

  const languageMap =
    categoryTranslations[currentLanguage] || {};

  if (languageMap[normalized]) {
    return languageMap[normalized];
  }

  const normalizedSlug =
    normalizeText(category.slug);

  if (languageMap[normalizedSlug]) {
    return languageMap[normalizedSlug];
  }

  return original;
};


