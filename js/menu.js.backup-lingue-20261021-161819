const renderMenuInfo = () => {
  const section =
    document.querySelector(".menu-info");

  if (!section) {
    return;
  }

  const settings =
    menuData?.settings || {};

  /*
   * Usa i dati del Worker quando sono disponibili.
   * Se manca uno dei due elenchi, usa i relativi
   * dati di riserva indipendentemente dall'altro.
   */
  const info = {
    extras: Array.isArray(settings.extras)
      ? settings.extras
      : defaultMenuInfo.extras,

    allergens: Array.isArray(settings.allergens)
      ? settings.allergens
      : defaultMenuInfo.allergens
  };

  const language =
    translations[currentLanguage] || translations.es;

  const extras = info.extras
    .map((item) => {
      if (!item) return null;
      const name = String(
        item[`name_${currentLanguage}`] || item.name_es || item.name || ""
      ).trim();
      if (!name) return null;

      const note = String(item.note || "").trim();
      const price = formatExtraPrice(item.price);

      return `
        <li>
          <span>
            ${escapeHtml(name)}
            ${note ? `<small>(${escapeHtml(note)})</small>` : ""}
          </span>
          <span>${escapeHtml(price)}</span>
        </li>
      `;
    })
    .filter(Boolean)
    .join("");

  const allergens = info.allergens
    .map((item) => {
      if (!item) return null;
      const name = String(
        item[`name_${currentLanguage}`] || item.name_es || item.name || ""
      ).trim();
      if (!name) return null;

      const number = String(item.number ?? item.code ?? "").trim();

      return `
        <li>
          <span>${escapeHtml(number)}</span>
          ${escapeHtml(name)}
        </li>
      `;
    })
    .filter(Boolean)
    .join("");

  section.innerHTML = `
    <div class="menu-info-inner">

      <div class="menu-extras">
        <span class="menu-info-kicker">
          ${escapeHtml(language["menuInfo.extrasKicker"])}
        </span>

        <h2>${escapeHtml(language["menuInfo.extrasTitle"])}</h2>

        <p class="menu-extras-note">
          ${escapeHtml(language["menuInfo.extrasNote"])}
        </p>

        <ul class="menu-extras-list">
          ${extras}
        </ul>
      </div>

      <div class="menu-allergens">
        <span class="menu-info-kicker">
          ${escapeHtml(language["menuInfo.allergensKicker"])}
        </span>

        <h2>${escapeHtml(language["menuInfo.allergensTitle"])}</h2>

        <p class="menu-allergens-intro">
          ${escapeHtml(language["menuInfo.allergensIntro"])}
        </p>

        <ul class="menu-allergens-list">
          ${allergens}
        </ul>
      </div>

    </div>
  `;
};


