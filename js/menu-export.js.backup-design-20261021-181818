(() => {
  const button = document.getElementById("generate-menu-document");
  const status = document.getElementById("export-status");
  if (!button || button.dataset.ready) return;
  button.dataset.ready = "1";

  const esc = v => String(v ?? "").replace(/[&<>"']/g, c =>
    ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"})[c]);

  const list = d => Array.isArray(d) ? d : d?.categories || d?.dishes || [];
  const money = n => (Number(n) / 100).toLocaleString("es-ES",
    {minimumFractionDigits:2,maximumFractionDigits:2}) + " €";

  button.addEventListener("click", async () => {
    button.disabled = true;
    status.textContent = "Preparazione della carta…";
    try {
      const lang = document.getElementById("export-language").value;
      const [cd, dd, info] = await Promise.all([
        api("/api/admin/categories"),
        api("/api/admin/dishes"),
        api("/api/admin/menu-info")
      ]);
      const categories = list(cd).sort((a,b) =>
        Number(a.sort_order || 0) - Number(b.sort_order || 0));
      const dishes = list(dd);
      const sections = categories.map(c => {
        const items = dishes.filter(d =>
          String(d.category_id) === String(c.id));
        if (!items.length) return "";
        const category = lang === "en"
          ? (c.name_en || c.name_es || "") : (c.name_es || "");
        return `<section><h2>${esc(category)}</h2>${items.map(d => {
          const name = d["name_" + lang] || d.name_es || "";
          const desc = d["description_" + lang] ||
            (lang === "es" ? d.description_es : "") || "";
          const p1 = d.price_cents == null ? "" : money(d.price_cents);
          const p2 = Number(d.price_max_cents) > Number(d.price_cents)
            ? " – " + money(d.price_max_cents) : "";
          return `<article><div class="dish"><h3>${esc(name)}</h3>
            <b>${esc(p1 + p2)}</b></div>
            ${desc ? `<p>${esc(desc)}</p>` : ""}
            ${d.allergens ? `<small>${lang === "en" ? "Allergens" : "Alérgenos"}: ${esc(d.allergens)}</small>` : ""}
          </article>`;
        }).join("")}</section>`;
      }).join("");
      const extras = (info?.extras || []).map(x =>
        `<li>${esc(x["name_" + lang] || x.name_es || x.name || "")}
        <span>${x.price ? esc(Number(x.price).toFixed(2) + " €") : ""}</span></li>`
      ).join("");

      const allergens = (info?.allergens || []).map(x =>
        `<li>${esc(x.code || x.number || "")} ${esc(x["name_" + lang] || x.name_es || x.name || "")}</li>`
      ).join("");
      const title = lang === "en" ? "MENU" : "CARTA";
      const logoUrl = new URL("../assets/images/logo_black.png", window.location.href).href;
      const html = `<!doctype html><html lang="${lang}"><head>
      <meta charset="utf-8"><title>Génesis — ${title}</title><style>
      @page{size:A4;margin:9mm 11mm}
      *{box-sizing:border-box}
      html{background:#fff}
      body{margin:0;color:#242820;background:#fff;font:8pt Arial,sans-serif;line-height:1.32}
      
      .logo{display:block;width:48mm;height:auto;max-height:14mm;object-fit:contain;margin:0 auto 2mm}
      header{text-align:center;border-bottom:1px solid #d7d9d0;padding:2mm 0 3mm;margin-bottom:4mm}
      
      .brand{letter-spacing:.28em;color:#68705a;font-size:7pt;text-transform:uppercase}
      h1{font:normal 22pt Georgia,serif;letter-spacing:.14em;color:#252820;margin:2mm 0}
      .ornament{color:#879078;font-size:11pt;letter-spacing:.18em}
      h2{font:normal 12pt Georgia,serif;color:#4b5440;border-bottom:1px solid #cdd2c5;padding:0 0 1.2mm;margin:3.5mm 0 2mm;break-after:avoid;page-break-after:avoid}
      
      article{break-inside:avoid;page-break-inside:avoid;margin:0 0 2.2mm;padding:0 0 1.5mm;border-bottom:1px solid #efeee9}
      .dish{display:flex;justify-content:space-between;gap:2mm;align-items:baseline;break-inside:avoid;page-break-inside:avoid}
      h3{font:normal 9pt Georgia,serif;color:#252820;margin:0;flex:1;min-width:0}
      .dish b{white-space:nowrap;font-size:7.5pt;font-weight:600;color:#4b5440}p{margin:1mm 0 0;color:#5e6059;font-size:7.5pt;line-height:1.3;break-inside:avoid;page-break-inside:avoid}
      small{display:block;margin-top:.7mm;font-size:6.3pt;line-height:1.25;color:#77786f;break-inside:avoid;page-break-inside:avoid}
      .extras{border-top:1px solid #cdd2c5;margin-top:4mm;padding-top:1mm;break-inside:avoid}
      .extras h2{font-size:10pt;margin:2mm 0}
      ul{padding:0;list-style:none;columns:2;column-gap:5mm;margin:1mm 0;font-size:7pt}li{break-inside:avoid;margin:.7mm 0;line-height:1.25}
      li span{float:right}footer{text-align:center;border-top:1px solid #d9d5ca;margin-top:3mm;padding-top:1mm;font-size:6.5pt;color:#77786f}
      .tools{text-align:center;background:#f2efe7;padding:10px}
      .tools button{padding:10px 16px;margin:3px;background:#343b30;color:white;border:0}
      @media print{.tools{display:none}}
      main.menu-columns{column-count:2;column-gap:8mm;column-fill:balance}
      section{break-inside:auto;orphans:2;widows:2}
      section h2{break-after:avoid-column;page-break-after:avoid}
      article{break-inside:avoid;break-inside:avoid-column;page-break-inside:avoid;orphans:2;widows:2}
      .dish,p,small{break-inside:avoid;page-break-inside:avoid}
      @media print{
        .tools{display:none}
        body{print-color-adjust:exact;-webkit-print-color-adjust:exact}
        header, h2, article{color-adjust:exact}
      }
</style></head><body>
      <div class="tools"><button onclick="window.print()">PDF / Imprimir</button></div>
      <header><img class="logo" src="${logoUrl}" alt="Génesis"><div class="brand">LA LAGUNA</div>
      <h1>${title}</h1><div class="ornament">— ✳ —</div></header>
      <main class="menu-columns">${sections}</main>
      <div class="extras"><h2>${lang === "en" ? "Extras" : "Extras"}</h2><ul>${extras}</ul>
      <h2>${lang === "en" ? "Allergens" : "Alérgenos"}</h2><ul>${allergens}</ul></div>
      <footer>GÉNESIS · LA LAGUNA</footer></body></html>`;
      const blob = new Blob([html], {type:"text/html;charset=utf-8"});
      const url = URL.createObjectURL(blob);
      const a = document.createElement("a");
      a.href = url; a.download = `genesis-menu-${lang}.html`;
      document.body.appendChild(a); a.click(); a.remove();
      window.open(url, "_blank");
      status.textContent = "Carta generata. Nel documento scegli PDF / Imprimir.";
    } catch (e) {
      console.error(e);
      status.textContent = "Errore: " + (e.message || "generazione non riuscita");
    } finally {
      button.disabled = false;
    }
  });
})();
