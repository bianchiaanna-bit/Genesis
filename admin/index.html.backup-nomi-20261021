function renderCategoryFilter() {
  if (!dishCategoryFilter) return;

  const current = dishCategoryFilter.value;

  dishCategoryFilter.innerHTML = '<option value="">Tutte</option>';

  categories.forEach(category => {
    const option = document.createElement("option");
    option.value = category.id || "";
    option.textContent = category.name_es || "Senza nome";
    dishCategoryFilter.appendChild(option);
  });

  const exists = Array.from(dishCategoryFilter.options)
    .some(option => option.value === current);

  dishCategoryFilter.value = exists ? current : "";
}

