  const container = document.getElementById("home-dishes-list");
  if (!container) return;

  container.innerHTML = "";

  if (!homeDishes.length) {
    container.innerHTML = `
      <div class="status">
        Non ci sono piatti configurati per la homepage.
      </div>
    `;
    return;
  }

  homeDishes.forEach((dish, index) => {
    const row = document.createElement("div");
    row.className = "home-dish-row";
    row.dataset.id = dish.id ?? "";

    const initialImageUrl = homeImageUrl(dish.image_key);

    const initialLabel =
      dish.label_it || dish.meta_it ||
      dish.label_es || dish.meta_es ||
      dish.label_en || dish.meta_en ||
      "IN EVIDENZA";

    const initialTitle =
      dish.title_it ||
      dish.title_es ||
      dish.title_en ||
      "Titolo del piatto";

    const initialText =
      dish.text_it ||
      dish.text_es ||
      dish.text_en ||
      "Il testo descrittivo apparirà qui.";

    row.innerHTML = `
      <div class="home-dish-preview">
        <div class="home-image-preview">
          ${
            initialImageUrl
              ? `<img
                   src="${escapeHtml(initialImageUrl)}"
                   alt="${escapeHtml(dish.alt_it || "")}"
                 >`
              : `<div class="home-image-placeholder">
                   Nessuna immagine
                 </div>`
          }
        </div>

        <div class="home-dish-preview-copy">
          <div class="home-dish-preview-meta">
            <span class="home-preview-label">
              ${escapeHtml(initialLabel)}
            </span>
          </div>

          <h3 class="home-preview-title">
            ${escapeHtml(initialTitle)}
          </h3>

          <p class="home-preview-text">
            ${escapeHtml(initialText)}
          </p>
        </div>
      </div>

      <div class="home-dish-editor">
        <div class="home-dish-top">
          <strong>Elemento homepage ${index + 1}</strong>

          <span class="home-dish-badge ${dish.published ? "" : "off"}">
            ${dish.published ? "Pubblicato" : "Non pubblicato"}
          </span>
        </div>

        <div class="home-dish-footer">
          <label>
            <input
              type="checkbox"
              class="home-published"
              ${dish.published ? "checked" : ""}
            >
            Pubblicato sul sito
          </label>

          <div class="field home-order-field">
            <label>Ordine di visualizzazione</label>
            <input
              type="number"
              class="home-sort-order"
              value="${Number(dish.sort_order || 0)}"
            >
          </div>
        </div>

        <div class="home-dish-file">
          <div class="field">
            <label>Chiave immagine</label>
            <input
              type="text"
              class="home-image-key"
              value="${escapeHtml(dish.image_key || "")}"
              placeholder="Chiave o URL dell'immagine"
            >
          </div>

          <div class="field home-upload-field">
            <label>Immagine della card</label>

            <div class="home-upload-controls">
              <input
                type="file"
                class="home-image-file"
                accept="image/jpeg,image/png,image/webp"
              >

              <button
                type="button"
                class="secondary home-upload-trigger"
                disabled
              >
                Carica foto
              </button>

              <span class="home-upload-filename">
                Nessun nuovo file selezionato
              </span>
            </div>

            <small>
              Formati consentiti: JPG, PNG o WebP. Massimo 8 MB.
            </small>
          </div>

          <div class="field">
            <label>Testo alternativo dell'immagine</label>
            <input
              type="text"
              class="home-alt"
              value="${escapeHtml(dish.alt_it || "")}"
              placeholder="Descrizione dell'immagine"
            >
          </div>
        </div>

        <div class="home-dish-languages">
          <div class="home-dish-language">
            <h4>Italiano</h4>

            <div class="field">
              <label>Etichetta IT</label>
              <input
                type="text"
                class="home-label-it"
                value="${escapeHtml(dish.label_it || dish.meta_it || "")}"
                placeholder="Es. DA PROVARE"
              >
            </div>

            <div class="field">
              <label>Titolo IT</label>
              <input
                type="text"
                class="home-title-it"
                value="${escapeHtml(dish.title_it || "")}"
                placeholder="Titolo in italiano"
              >
            </div>

            <div class="field">
              <label>Testo IT</label>
              <textarea
                class="home-text-it"
                placeholder="Descrizione in italiano"
              >${escapeHtml(dish.text_it || "")}</textarea>
            </div>
          </div>

          <div class="home-dish-language">
            <h4>Español</h4>

            <div class="field">
              <label>Etiqueta ES</label>
              <input
                type="text"
                class="home-label-es"
                value="${escapeHtml(dish.label_es || dish.meta_es || "")}"
                placeholder="Ej. RECOMENDADO"
              >
            </div>

            <div class="field">
              <label>Título ES</label>
              <input
                type="text"
                class="home-title-es"
                value="${escapeHtml(dish.title_es || "")}"
                placeholder="Título en español"
              >
            </div>

            <div class="field">
              <label>Texto ES</label>
              <textarea
                class="home-text-es"
                placeholder="Descripción en español"
              >${escapeHtml(dish.text_es || "")}</textarea>
            </div>
          </div>

          <div class="home-dish-language">
            <h4>English</h4>

            <div class="field">
              <label>Label EN</label>
              <input
                type="text"
                class="home-label-en"
                value="${escapeHtml(dish.label_en || dish.meta_en || "")}"
                placeholder="E.g. MUST TRY"
              >
            </div>

            <div class="field">
              <label>Title EN</label>
              <input
                type="text"
                class="home-title-en"
                value="${escapeHtml(dish.title_en || "")}"
                placeholder="Title in English"
              >
            </div>

            <div class="field">
              <label>Text EN</label>
              <textarea
                class="home-text-en"
