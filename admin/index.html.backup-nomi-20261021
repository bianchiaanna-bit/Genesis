function getFilteredDishes() {
  const filter = dishCategoryFilter?.value || "";
  const search = normalizeSearch(dishSearch?.value || "");

  return dishes.filter(dish => {
    if (filter && String(dish.category_id) !== String(filter)) return false;
    if (!search) return true;

    const category = categories.find(
      item => String(item.id) === String(dish.category_id)
    );

    const text = [
      dish.name_es,
      dish.description_es,
      dish.allergens,
      category?.name_es
    ].map(normalizeSearch).join(" ");

    return text.includes(search);
  });
}

