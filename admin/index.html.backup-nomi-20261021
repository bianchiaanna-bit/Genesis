/* =====================================================
   UTILITY
   ===================================================== */

function escapeHtml(value) {
  return String(value ?? "")
    .replace(/&/g, "&amp;")
    .replace(/</g, "&lt;")
    .replace(/>/g, "&gt;")
    .replace(/"/g, "&quot;")
    .replace(/'/g, "&#039;");
}

function showStatus(element, message, type = "") {
  if (!element) return;

  element.className = "status";
  if (type) element.classList.add(type);

  element.textContent = message;
  element.classList.remove("hidden");
}

function hideStatus(element) {
  if (!element) return;
  element.classList.add("hidden");
  element.textContent = "";
}

function normalizeSearch(value) {
  return String(value ?? "")
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

function parseBoolean(value) {
  if (typeof value === "boolean") return value;

  const normalized = String(value ?? "").trim().toUpperCase();
  return ["SI", "SÌ", "OK", "YES", "TRUE", "1"].includes(normalized);
}

function normalizeHeader(value) {
  return String(value ?? "")
    .trim()
    .toLowerCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .replace(/\s+/g, " ");
}

function numberFromExcel(value) {
  if (value === null || value === undefined || value === "") return null;
  if (typeof value === "number") return value;

  const number = Number(String(value).trim().replace(",", "."));
  return Number.isFinite(number) ? number : null;
}

function priceToCents(value) {
  const number = numberFromExcel(value);
  return number === null ? null : Math.round(number * 100);
}

/* =====================================================
   API
   ===================================================== */

async function api(path, options = {}) {
  const headers = {
    ...(options.headers || {}),
    Authorization: `Bearer ${token}`
  };

  const response = await fetch(API + path, {
    ...options,
    headers,
    credentials: "include"
  });

  let data = null;

  try {
    data = await response.json();
  } catch {
    data = null;
  }

  if (!response.ok) {
    throw new Error(
      data?.error ||
      data?.message ||
      `Errore HTTP ${response.status}`
    );
  }

  return data;
}

/* =====================================================
   LOGIN
   ===================================================== */

async function login() {
  hideStatus(loginStatus);

  if (loginButton) {
    loginButton.disabled = true;
    loginButton.textContent = "Accesso...";
  }

  try {
    const response = await fetch(API + "/api/admin/login", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ password: loginPassword?.value || "" }),
      credentials: "include"
    });

    let data = null;

    try {
      data = await response.json();
    } catch {
      data = null;
    }

    if (!response.ok) {
      throw new Error(data?.error || data?.message || "Password non valida");
    }

    token = data?.session || data?.token || "";

    if (!token) {
      throw new Error("Il server non ha restituito il token di sessione.");
    }

    localStorage.setItem("genesis_admin_token", token);

    loginScreen?.classList.add("hidden");
    adminScreen?.classList.add("visible");

    await loadEverything();
  } catch (error) {
    showStatus(loginStatus, error.message, "error");
  } finally {
    if (loginButton) {
      loginButton.disabled = false;
      loginButton.textContent = "Accedi";
    }
  }
}

loginButton?.addEventListener("click", login);

