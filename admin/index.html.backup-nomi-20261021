/* =====================================================
   SOTTO-SCHEDE MENU
   ===================================================== */

function activateMenuPanel(panelId) {
  document.querySelectorAll(".menu-subtab[data-menu-panel]").forEach(button => {
    button.classList.toggle("active", button.dataset.menuPanel === panelId);
  });

  document.querySelectorAll(".menu-panel").forEach(panel => {
    panel.classList.toggle("hidden", panel.id !== panelId);
  });

  if (panelId !== "import-panel") resetImportUI();
}

document.querySelectorAll(".menu-subtab[data-menu-panel]").forEach(button => {
  button.addEventListener("click", () => {
    activateMenuPanel(button.dataset.menuPanel);
  });
});

const initialMenuButton = document.querySelector(
  '.menu-subtab[data-menu-panel].active'
);

if (initialMenuButton) {
  activateMenuPanel(initialMenuButton.dataset.menuPanel);
} else if (document.getElementById("categories-panel")) {
  activateMenuPanel("categories-panel");
}

/* =====================================================
   SCHEDE PRINCIPALI
   ===================================================== */

document.querySelectorAll(".tab-button[data-tab]").forEach(button => {
  button.addEventListener("click", () => {
    const tab = button.dataset.tab;

    if (tab !== "menu") resetImportUI();

    document.querySelectorAll(".tab-button[data-tab]").forEach(item => {
      item.classList.toggle("active", item === button);
    });

    document.querySelectorAll(".tab-content").forEach(content => {
      content.classList.toggle("hidden", content.id !== `tab-${tab}`);
    });
  });
});

