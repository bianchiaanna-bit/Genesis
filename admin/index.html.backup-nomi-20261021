document.getElementById("save-home-dishes")?.addEventListener(
  "click",
  async () => {
    const button = document.getElementById("save-home-dishes");
    const status = document.getElementById("home-dishes-status");

    if (button) button.disabled = true;
    hideStatus(status);

    try {
      const rows = document.querySelectorAll(".home-dish-row");

      for (const row of rows) {
        const id = row.dataset.id;

        if (!id) {
          throw new Error(
            "Un elemento homepage non ha un ID valido."
          );
        }

        const payload = {
          image_key:
            row.querySelector(".home-image-key")?.value.trim() || "",

          alt_it:
            row.querySelector(".home-alt")?.value.trim() || "",

          // Compatibilità con il Worker attuale: il database usa meta_*.
          meta_it:
            row.querySelector(".home-label-it")?.value.trim() || "",

          meta_es:
            row.querySelector(".home-label-es")?.value.trim() || "",

          meta_en:
            row.querySelector(".home-label-en")?.value.trim() || "",

          title_it:
            row.querySelector(".home-title-it")?.value.trim() || "",

          title_es:
            row.querySelector(".home-title-es")?.value.trim() || "",

          title_en:
            row.querySelector(".home-title-en")?.value.trim() || "",

          text_it:
            row.querySelector(".home-text-it")?.value.trim() || "",

          text_es:
            row.querySelector(".home-text-es")?.value.trim() || "",

          text_en:
            row.querySelector(".home-text-en")?.value.trim() || "",

          published:
            row.querySelector(".home-published")?.checked ?? false,

          sort_order:
            Number(
              row.querySelector(".home-sort-order")?.value || 0
            )
        };

        await api(
          `/api/admin/home-dishes/${encodeURIComponent(id)}`,
          {
            method: "PATCH",
            headers: {
              "Content-Type": "application/json"
            },
            body: JSON.stringify(payload)
          }
        );
      }

      await loadHomeDishes();

      showStatus(
        status,
        "Contenuti della homepage salvati.",
        "success"
      );
    } catch (error) {
      showStatus(status, error.message, "error");
    } finally {
      if (button) button.disabled = false;
    }
  }
);

