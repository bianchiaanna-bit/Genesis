async function loadPopups() {
  const data = await api("/api/admin/popups");
  popups = Array.isArray(data) ? data : data?.popups || [];
  renderPopups();
}

function renderPopups() {
  const container = document.getElementById("popups-list");
  if (!container) return;

  container.innerHTML = "";

  popups.forEach(popup => {
    const row = document.createElement("div");
    row.className = "popup-row";

    row.innerHTML = `
      <div class="grid">
        <div class="field">
          <label>Titolo</label>
          <input class="popup-title" value="${escapeHtml(popup.title_es || "")}">
        </div>

        <div class="field">
          <label>Testo</label>
          <textarea class="popup-text">${escapeHtml(popup.text_es || "")}</textarea>
        </div>

        <div class="field">
          <label>Testo pulsante</label>
          <input class="popup-button-text" value="${escapeHtml(popup.button_text_es || "")}">
        </div>

        <div class="field">
          <label>URL pulsante</label>
          <input class="popup-button-url" value="${escapeHtml(popup.button_url || "")}">
        </div>

        <div class="field">
          <label>Testo linguetta</label>
          <input class="popup-tab-text" value="${escapeHtml(popup.tab_text || "")}">
        </div>

        <div class="field">
          <label>Inizio</label>
          <input class="popup-start" type="datetime-local"
            value="${popup.starts_at ? String(popup.starts_at).slice(0, 16) : ""}">
        </div>

        <div class="field">
          <label>Fine</label>
          <input class="popup-end" type="datetime-local"
            value="${popup.ends_at ? String(popup.ends_at).slice(0, 16) : ""}">
        </div>
      </div>

      <div class="checkboxes">
        <label><input type="checkbox" class="popup-published" ${popup.published ? "checked" : ""}> Pubblicato</label>
        <button type="button" class="danger delete-popup">Elimina</button>
      </div>
    `;

    row.querySelector(".delete-popup").addEventListener("click", async () => {
      if (!popup.id) {
        popups = popups.filter(item => item !== popup);
        renderPopups();
        return;
      }

      if (!confirm("Eliminare questo pop-up?")) return;

      try {
        await api(`/api/admin/popups/${popup.id}`, { method: "DELETE" });
        await loadPopups();
      } catch (error) {
        alert(error.message);
      }
    });

    container.appendChild(row);
  });
}

document.getElementById("add-popup")?.addEventListener("click", () => {
  popups.unshift({
    id: null,
    title_es: "",
    text_es: "",
    button_text_es: "",
    button_url: "",
    tab_text: "News",
    starts_at: null,
    ends_at: null,
    published: false
  });

  renderPopups();
});

document.getElementById("save-popups")?.addEventListener("click", async () => {
  const button = document.getElementById("save-popups");
  if (button) button.disabled = true;

  try {
    const rows = document.querySelectorAll(".popup-row");

    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      const popup = popups[i];

      const payload = {
        title_es: row.querySelector(".popup-title").value.trim(),
        text_es: row.querySelector(".popup-text").value.trim(),
        button_text_es: row.querySelector(".popup-button-text").value.trim(),
        button_url: row.querySelector(".popup-button-url").value.trim(),
        tab_text: row.querySelector(".popup-tab-text").value.trim(),
        starts_at: row.querySelector(".popup-start").value || null,
        ends_at: row.querySelector(".popup-end").value || null,
        published: row.querySelector(".popup-published").checked
      };

      if (popup.id) {
        await api(`/api/admin/popups/${popup.id}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
      } else {
        await api("/api/admin/popups", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
      }
    }

    await loadPopups();
    showStatus(document.getElementById("popups-status"), "Pop-up salvati.", "success");
  } catch (error) {
    showStatus(document.getElementById("popups-status"), error.message, "error");
  } finally {
    if (button) button.disabled = false;
  }
});

/* =====================================================
   ORARI
   ===================================================== */

async function loadHours() {
  /*
   * Manteniamo la route pubblica che era presente nel vecchio script.
   * Il Worker può restituire direttamente l'elenco o un oggetto con hours.
   */
  const data = await api("/api/opening-hours");

  hours = Array.isArray(data) ? data : data?.hours || [];

  hours = hours.map(hour => {
    let timeValue = "";

    if (hour.hours !== undefined && hour.hours !== null) {
      timeValue = String(hour.hours);
    } else if (hour.open_time || hour.close_time) {
      const open = hour.open_time || "";
      const close = hour.close_time || "";
      timeValue = open && close ? `${open} - ${close}` : (open || close);
    }

    return {
      ...hour,
      day_name: hour.day_name || hour.day_label || hour.day || "",
      hours: timeValue
    };
  });

  renderHours();
}

function renderHours() {
  const container = document.getElementById("hours-list");
  if (!container) return;

  container.innerHTML = "";

  hours.forEach(hour => {
    const row = document.createElement("div");
    row.className = "hours-row";

    row.innerHTML = `
      <input class="hours-day" value="${escapeHtml(hour.day_name || "")}" placeholder="Giorno">
      <input class="hours-time" value="${escapeHtml(hour.hours || "")}" placeholder="09:00 - 18:00">
      <button type="button" class="danger delete-hour">Elimina</button>
    `;

    row.querySelector(".delete-hour").addEventListener("click", async () => {
      if (!hour.id) {
        hours = hours.filter(item => item !== hour);
        renderHours();
        return;
      }

      if (!confirm("Eliminare questo orario?")) return;

      try {
        await api(`/api/admin/opening-hours/${hour.id}`, { method: "DELETE" });
        await loadHours();
      } catch (error) {
        alert(error.message);
      }
    });

    container.appendChild(row);
  });
}

document.getElementById("add-hour")?.addEventListener("click", () => {
  hours.push({ id: null, day_name: "", hours: "" });
  renderHours();
});

document.getElementById("save-hours")?.addEventListener("click", async () => {
  const button = document.getElementById("save-hours");
  if (button) button.disabled = true;

  try {
    const rows = document.querySelectorAll(".hours-row");

    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      const hour = hours[i];

      const dayName = row.querySelector(".hours-day").value.trim();
      const hoursValue = row.querySelector(".hours-time").value.trim();

      if (!dayName) continue;

      const payload = { day_name: dayName, hours: hoursValue };

      if (hour.id) {
        await api(`/api/admin/opening-hours/${hour.id}`, {
          method: "PATCH",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
      } else {
        await api("/api/admin/opening-hours", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify(payload)
        });
      }
    }

    await loadHours();
    showStatus(document.getElementById("hours-status"), "Orari salvati.", "success");
  } catch (error) {
    showStatus(document.getElementById("hours-status"), error.message, "error");
  } finally {
    if (button) button.disabled = false;
  }
});

/* =====================================================
   IMPORTAZIONE EXCEL
   ===================================================== */

function resetImportUI() {
  importRows = [];
  importFile = null;

  if (importFileInput) importFileInput.value = "";

  if (importSummary) {
    importSummary.innerHTML = "";
    importSummary.className = "import-summary hidden";
  }

  if (importPreview) {
    importPreview.innerHTML = "";
    importPreview.classList.add("hidden");
  }

  importActions?.classList.add("hidden");
  if (importButton) importButton.disabled = true;
  importProgress?.classList.add("hidden");

  if (importProgressBar) importProgressBar.style.width = "0%";
}

function importHeaderMap(headers) {
  const aliases = {
    nome: ["nome", "name"],
    categoria: ["categoria", "category"],
    prezzo: ["prezzo (€)", "prezzo", "prezzo euro", "price"],
    prezzo_massimo: ["prezzo massimo (€)", "prezzo massimo", "prezzo max", "price max"],
    ordine: ["ordine nella categoria", "ordine", "sort order", "sort_order"],
    descrizione: ["descrizione", "description"],
    allergeni: ["allergeni", "allergens"],
    disponibile: ["disponibile", "available"],
    vegetariano: ["vegetariano", "vegetarian"],
    vegano: ["vegano", "vegan"]
  };

  const map = {};

  headers.forEach((header, index) => {
    const normalized = normalizeHeader(header);

    for (const key in aliases) {
      if (aliases[key].includes(normalized)) {
        map[key] = index;
        break;
      }
    }
  });

  return map;
}

function renderImportPreview(rows) {
  if (!importPreview) return;

  if (!rows.length) {
    importPreview.innerHTML = "";
    importPreview.classList.add("hidden");
    return;
  }

  const headers = [
    "Nome", "Categoria", "Prezzo (€)", "Prezzo massimo (€)",
    "Ordine nella categoria", "Descrizione", "Allergeni",
    "Disponibile", "Vegetariano", "Vegano"
  ];

  let html = "<table><thead><tr>";
  headers.forEach(header => html += `<th>${escapeHtml(header)}</th>`);
  html += "</tr></thead><tbody>";

  rows.slice(0, 100).forEach(row => {
    html += `
      <tr>
        <td>${escapeHtml(row.nome)}</td>
        <td>${escapeHtml(row.categoria)}</td>
        <td>${escapeHtml(row.prezzo)}</td>
        <td>${escapeHtml(row.prezzo_massimo)}</td>
        <td>${escapeHtml(row.ordine)}</td>
        <td>${escapeHtml(row.descrizione)}</td>
        <td>${escapeHtml(row.allergeni)}</td>
        <td>${row.disponibile ? "SI" : "NO"}</td>
        <td>${row.vegetariano ? "SI" : "NO"}</td>
        <td>${row.vegano ? "SI" : "NO"}</td>
      </tr>
    `;
  });

  html += "</tbody></table>";
  importPreview.innerHTML = html;
  importPreview.classList.remove("hidden");
}

async function handleImportFile(file) {
  resetImportUI();
  if (!file) return;

  importFile = file;

  try {
    const buffer = await file.arrayBuffer();
    const workbook = XLSX.read(buffer, { type: "array" });
    const sheetName = workbook.SheetNames[0];

    if (!sheetName) throw new Error("Il file non contiene un foglio Excel.");

    const matrix = XLSX.utils.sheet_to_json(workbook.Sheets[sheetName], {
      header: 1,
      defval: ""
    });

    if (matrix.length < 2) throw new Error("Il file non contiene dati da importare.");

    const headerMap = importHeaderMap(matrix[0]);
    const required = ["nome", "categoria", "prezzo"];
    const missing = required.filter(key => headerMap[key] === undefined);

    if (missing.length) {
      throw new Error("Mancano colonne obbligatorie: " + missing.join(", "));
    }

    importRows = matrix.slice(1)
      .filter(row => row.some(value => String(value ?? "").trim() !== ""))
      .map(row => {
        const get = key => headerMap[key] !== undefined ? row[headerMap[key]] : "";

        return {
          nome: String(get("nome") ?? "").trim(),
          categoria: String(get("categoria") ?? "").trim(),
          prezzo: get("prezzo"),
          prezzo_massimo: get("prezzo_massimo"),
          ordine: get("ordine"),
          descrizione: String(get("descrizione") ?? "").trim(),
          allergeni: String(get("allergeni") ?? "").trim(),
          disponibile: parseBoolean(get("disponibile")),
          vegetariano: parseBoolean(get("vegetariano")),
          vegano: parseBoolean(get("vegano"))
        };
      });

    if (!importRows.length) throw new Error("Non sono presenti righe valide nel file.");

    renderImportPreview(importRows);
    importActions?.classList.remove("hidden");
    if (importButton) importButton.disabled = false;
  } catch (error) {
    if (importSummary) {
      importSummary.innerHTML = `
        <strong>Errore nella lettura del file</strong><br>
        ${escapeHtml(error.message)}
      `;
      importSummary.className = "import-summary import-error";
    }
  }
}

importFileInput?.addEventListener("change", event => {
  handleImportFile(event.target.files?.[0]);
});

function verifyImportedDishes(rows) {
  const existingNames = new Set(
    dishes.map(dish => normalizeSearch(dish.name_es)).filter(Boolean)
  );

  const importedNames = [...new Set(
    rows.map(row => normalizeSearch(row.nome)).filter(Boolean)
  )];

  const missing = importedNames.filter(name => !existingNames.has(name));

  return {
    total: importedNames.length,
    verified: importedNames.length - missing.length,
    missing
  };
}

function showImportResult(result, verifiedCount, totalCount) {
  if (!importSummary) return;

  const safeResult = result && typeof result === "object" ? result : {};
  const categoriesCreated = Number(safeResult.categories_created ?? safeResult.categoriesCreated ?? 0);
  const dishesCreated = Number(safeResult.dishes_created ?? safeResult.dishesCreated ?? 0);
  const dishesUpdated = Number(safeResult.dishes_updated ?? safeResult.dishesUpdated ?? 0);
  const errors = Array.isArray(safeResult.errors) ? safeResult.errors : [];

  let html = '<div class="import-summary-title">✓ Importazione completata</div>';

  if (totalCount > 0 && verifiedCount === totalCount) {
    html += `<div style="margin-bottom:8px"><strong>${verifiedCount} di ${totalCount}</strong> piatti verificati nell'elenco del database.</div>`;
  }

  const hasServerSummary = [
    "categories_created", "categoriesCreated", "dishes_created",
    "dishesCreated", "dishes_updated", "dishesUpdated"
  ].some(key => key in safeResult);

  if (hasServerSummary) {
    html += `
      <div class="import-summary-stats">
        <div class="import-summary-stat">Categorie create: <span>${categoriesCreated}</span></div>
        <div class="import-summary-stat">Piatti creati: <span>${dishesCreated}</span></div>
        <div class="import-summary-stat">Piatti aggiornati: <span>${dishesUpdated}</span></div>
      </div>
    `;
  } else {
    html += "<div>Il server non ha restituito il riepilogo numerico, ma i dati sono stati verificati nuovamente nell'elenco del database.</div>";
  }

  if (errors.length) {
    html += `
      <div style="margin-top:10px;color:#a12d25"><strong>${errors.length} errori</strong></div>
      <ul style="margin:6px 0 0;padding-left:20px">
        ${errors.slice(0, 20).map(error => `<li>${escapeHtml(typeof error === "string" ? error : JSON.stringify(error))}</li>`).join("")}
      </ul>
    `;

    if (errors.length > 20) {
      html += `<div style="margin-top:6px">... e altri ${errors.length - 20} errori.</div>`;
    }
  }

  importSummary.innerHTML = html;
  importSummary.className = "import-summary import-done";
}

async function runImport() {
  if (!importRows.length) return;

  importButton.disabled = true;
  if (importCancel) importCancel.disabled = true;

  importProgress?.classList.remove("hidden");
  if (importProgressBar) importProgressBar.style.width = "5%";

  importSummary.className = "import-summary";
  importSummary.textContent = "Importazione in corso...";

  const rowsToVerify = importRows.map(row => ({ ...row }));

  try {
    const result = await api("/api/admin/import-menu", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ dishes: rowsToVerify })
    });

    if (importProgressBar) importProgressBar.style.width = "65%";

    await loadMenu();

    if (importProgressBar) importProgressBar.style.width = "85%";

    if (dishSearch) dishSearch.value = "";
    if (dishCategoryFilter) dishCategoryFilter.value = "";
    renderDishes();

    const verification = verifyImportedDishes(rowsToVerify);

    if (verification.missing.length) {
      const missingPreview = verification.missing.slice(0, 10)
        .map(name => `<li>${escapeHtml(name)}</li>`).join("");

      importSummary.innerHTML = `
        <div class="import-summary-title">⚠ Importazione non verificata completamente</div>
        <div>Trovati <strong>${verification.verified}</strong> di <strong>${verification.total}</strong> piatti nell'elenco aggiornato.</div>
        <div style="margin-top:8px">Questi nomi non risultano nel database:</div>
        <ul style="margin:6px 0 0;padding-left:20px">${missingPreview}</ul>
        ${verification.missing.length > 10 ? `<div style="margin-top:6px">... e altri ${verification.missing.length - 10}.</div>` : ""}
        <div style="margin-top:10px">Controlla la risposta dell'API prima di considerare conclusa l'importazione.</div>
      `;

      importSummary.className = "import-summary import-warning";
      importButton.disabled = false;
      return;
    }

    if (importProgressBar) importProgressBar.style.width = "100%";

    showImportResult(result, verification.verified, verification.total);

    importPreview?.classList.add("hidden");
    if (importPreview) importPreview.innerHTML = "";
    importActions?.classList.add("hidden");

    importRows = [];
    importFile = null;
    if (importFileInput) importFileInput.value = "";
    importButton.disabled = true;
  } catch (error) {
    importSummary.innerHTML = `
      <div class="import-summary-title">✕ Importazione non completata</div>
      <div>${escapeHtml(error.message)}</div>
    `;
    importSummary.className = "import-summary import-error";
    importButton.disabled = false;
  } finally {
    if (importCancel) importCancel.disabled = false;
  }
}

importButton?.addEventListener("click", runImport);
importCancel?.addEventListener("click", resetImportUI);

