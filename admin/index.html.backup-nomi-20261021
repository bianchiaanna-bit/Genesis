async function loadMenuInfo() {
  try {
    const data = await api("/api/admin/menu-info");

    menuInfo = {
      extras: Array.isArray(data?.extras)
        ? data.extras.map(item => {
            const nameEs = String(item.name_es ?? item.name ?? "");
            return {
              name: nameEs,
              name_es: nameEs,
              name_en: String(item.name_en ?? ""),
              name_it: String(item.name_it ?? ""),
              price: Number(item.price ?? 0)
            };
          })
        : DEFAULT_EXTRAS.map(item => ({ ...item })),

      allergens: Array.isArray(data?.allergens)
        ? data.allergens.map(item => {
            const nameEs = String(item.name_es ?? item.name ?? "");
            return {
              code: String(item.code ?? item.number ?? ""),
              name: nameEs,
              name_es: nameEs,
              name_en: String(item.name_en ?? ""),
              name_it: String(item.name_it ?? "")
            };
          })
        : DEFAULT_ALLERGENS.map(item => ({ ...item }))
    };

    menuInfoLoaded = true;
    hideStatus(extrasStatus);
    hideStatus(allergensStatus);
    renderExtras();
    renderAllergens();
  } catch (error) {
    menuInfoLoaded = false;

    showStatus(
      extrasStatus,
      `Impossibile caricare gli extra: ${error.message}`,
      "error"
    );

    showStatus(
      allergensStatus,
      `Impossibile caricare gli allergeni: ${error.message}`,
      "error"
    );
  }
}

