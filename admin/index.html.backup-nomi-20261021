/* =====================================================
   EXTRA — LEGGI I VALORI DAL MODULO
   ===================================================== */

function readExtrasFromForm() {
  if (!extrasList) {
    throw new Error("Sezione Extra non trovata.");
  }

  const rows = Array.from(extrasList.querySelectorAll(".extra-row"));

  return rows.map((row, index) => {
    const name_es = row.querySelector(".extra-name-es")?.value.trim() ?? "";
    const name_en = row.querySelector(".extra-name-en")?.value.trim() ?? "";
    const name_it = row.querySelector(".extra-name-it")?.value.trim() ?? "";

    const rawPrice = String(
      row.querySelector(".extra-price")?.value ?? ""
    ).trim().replace(",", ".");

    const price = Number(rawPrice);

    if (!name_es) {
      throw new Error(
        `Inserisci il nome spagnolo dell'extra alla riga ${index + 1}.`
      );
    }

    if (rawPrice === "" || !Number.isFinite(price) || price < 0) {
      throw new Error(
        `Inserisci un prezzo valido per "${name_es}".`
      );
    }

    return {
      name: name_es,
      name_es,
      name_en,
      name_it,
      price
    };
  });
}

/* =====================================================
   ALLERGENI — LEGGI I VALORI DAL MODULO
   ===================================================== */

function readAllergensFromForm() {
  if (!allergensList) {
    throw new Error("Sezione Allergeni non trovata.");
  }

  const rows = Array.from(allergensList.querySelectorAll(".allergen-row"));

  return rows.map((row, index) => {
    const code = row.querySelector(".allergen-code")?.value.trim() ?? "";
    const name_es = row.querySelector(".allergen-name-es")?.value.trim() ?? "";
    const name_en = row.querySelector(".allergen-name-en")?.value.trim() ?? "";
    const name_it = row.querySelector(".allergen-name-it")?.value.trim() ?? "";

    if (!code || !name_es) {
      throw new Error(
        `Completa codice e nome spagnolo dell'allergene alla riga ${index + 1}.`
      );
    }

    return {
      code,
      name: name_es,
      name_es,
      name_en,
      name_it
    };
  });
}

/* =====================================================
   SALVATAGGIO — FUNZIONE COMUNE
   ===================================================== */

async function saveMenuInfoSection(section) {
  const isExtras = section === "extras";

  const button = isExtras
    ? saveExtrasButton
    : saveAllergensButton;

  const status = isExtras
    ? extrasStatus
    : allergensStatus;

  if (!button || !status) return;

  if (!menuInfoLoaded) {
    showStatus(
      status,
      "Dati non caricati. Ricarica la sezione prima di salvare.",
      "error"
    );
    return;
  }

  const originalText = button.textContent;

  button.disabled = true;
  button.textContent = "Salvataggio…";

  try {
    const extras = isExtras
      ? readExtrasFromForm()
      : menuInfo.extras.map(item => ({ ...item }));

    const allergens = isExtras
      ? menuInfo.allergens.map(item => ({ ...item }))
      : readAllergensFromForm();

    const response = await api("/api/admin/menu-info", {
      method: "PUT",
      headers: {
        "Content-Type": "application/json"
      },
      body: JSON.stringify({
        extras,
        allergens
      })
    });

    if (response?.success !== true) {
      throw new Error(
        response?.error ||
        response?.message ||
        "Il server non ha confermato il salvataggio."
      );
    }

    menuInfo = {
      extras,
      allergens
    };

    if (isExtras) {
      renderExtras();
    } else {
      renderAllergens();
    }

    showStatus(
      status,
      isExtras
        ? "Extra salvati correttamente."
        : "Allergeni salvati correttamente.",
      "success"
    );
  } catch (error) {
    showStatus(status, error.message, "error");
  } finally {
    button.disabled = false;
    button.textContent = originalText;
  }
}


