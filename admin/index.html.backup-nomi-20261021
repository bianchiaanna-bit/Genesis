   LOGOUT
   ===================================================== */

document.getElementById("logout-button")?.addEventListener("click", () => {
  token = "";
  localStorage.removeItem("genesis_admin_token");

  resetImportUI();

  adminScreen?.classList.remove("visible");
  loginScreen?.classList.remove("hidden");

  if (loginPassword) loginPassword.value = "";
});

/* =====================================================
   AVVIO
   ===================================================== */

async function init() {
  if (!token) return;

  loginScreen?.classList.add("hidden");
  adminScreen?.classList.add("visible");

  /*
   * Non eliminiamo la sessione se una singola sezione fallisce:
   * loadEverything gestisce separatamente gli errori di caricamento.
   */
  await loadEverything();
}

init();
