    const previewImage = row.querySelector(".home-image-preview");
    const previewLabel = row.querySelector(".home-preview-label");
    const previewTitle = row.querySelector(".home-preview-title");
    const previewText = row.querySelector(".home-preview-text");

    const publishedCheckbox = row.querySelector(".home-published");
    const publishedBadge = row.querySelector(".home-dish-badge");

    const imageKeyInput = row.querySelector(".home-image-key");
    const imageAltInput = row.querySelector(".home-alt");

    const fileInput = row.querySelector(".home-image-file");
    const uploadButton = row.querySelector(".home-upload-trigger");
    const uploadFilename = row.querySelector(".home-upload-filename");

    /*
     * Aggiorna l'anteprima.
     * Priorità dei contenuti: italiano, spagnolo, inglese.
     */

    function updateHomePreview() {
      const label =
        row.querySelector(".home-label-it").value.trim() ||
        row.querySelector(".home-label-es").value.trim() ||
        row.querySelector(".home-label-en").value.trim() ||
        "IN EVIDENZA";

      const title =
        row.querySelector(".home-title-it").value.trim() ||
        row.querySelector(".home-title-es").value.trim() ||
        row.querySelector(".home-title-en").value.trim() ||
        "Titolo del piatto";

      const text =
        row.querySelector(".home-text-it").value.trim() ||
        row.querySelector(".home-text-es").value.trim() ||
        row.querySelector(".home-text-en").value.trim() ||
        "Il testo descrittivo apparirà qui.";

      previewLabel.textContent = label;
      previewTitle.textContent = title;
      previewText.textContent = text;

      const imageUrl = homeImageUrl(imageKeyInput.value.trim());

      if (imageUrl) {
        let img = previewImage.querySelector("img");

        if (!img) {
          previewImage.innerHTML = "";
          img = document.createElement("img");
          previewImage.appendChild(img);
        }

        img.src = imageUrl;
        img.alt = imageAltInput.value.trim();
      } else {
        previewImage.innerHTML = `
          <div class="home-image-placeholder">
            Nessuna immagine
          </div>
        `;
      }

      const isPublished = publishedCheckbox.checked;

      row.classList.toggle("is-unpublished", !isPublished);

      publishedBadge.textContent = isPublished
        ? "Pubblicato"
        : "Non pubblicato";

      publishedBadge.classList.toggle("off", !isPublished);
    }

    /*
     * Aggiornamento dell'anteprima durante la digitazione.
     */

    [
      ".home-label-it",
      ".home-label-es",
      ".home-label-en",
      ".home-title-it",
      ".home-title-es",
      ".home-title-en",
      ".home-text-it",
      ".home-text-es",
      ".home-text-en",
      ".home-image-key",
      ".home-alt"
    ].forEach(selector => {
      row.querySelector(selector)?.addEventListener(
        "input",
        updateHomePreview
      );
    });

    publishedCheckbox.addEventListener(
      "change",
      updateHomePreview
    );

    /*
     * La selezione del file non avvia il caricamento.
     * L'upload parte soltanto cliccando "Carica foto".
     */

    fileInput.addEventListener("change", event => {
      const file = event.target.files?.[0];
      if (!file) return;

      const allowedTypes = ["image/jpeg", "image/png", "image/webp"];
      if (!allowedTypes.includes(file.type)) {
        alert("Seleziona un'immagine JPG, PNG o WebP.");
        fileInput.value = "";
        uploadButton.disabled = true;
        uploadFilename.textContent = "Nessun nuovo file selezionato";
        return;
      }

      if (file.size > 8 * 1024 * 1024) {
        alert("L'immagine non può superare 8 MB.");
        fileInput.value = "";
        uploadButton.disabled = true;
        uploadFilename.textContent = "Nessun nuovo file selezionato";
        return;
      }

      uploadFilename.textContent = file.name;
      uploadButton.disabled = false;
      uploadButton.textContent = "Carica foto";
    });

    uploadButton.addEventListener("click", async () => {
      const file = fileInput.files?.[0];
      if (!file) {
        alert("Seleziona prima una foto.");
        return;
      }

      const originalButtonText = "Carica foto";
      uploadButton.disabled = true;
      uploadButton.textContent = "Caricamento…";

      try {
        const uploaded = await api("/api/admin/images", {
          method: "POST",
          headers: { "Content-Type": file.type },
          body: file
        });

        const key = uploaded?.key || uploaded?.image_key || "";
        if (!key) {
          throw new Error("Il server non ha restituito la chiave dell'immagine.");
        }

        imageKeyInput.value = key;
        updateHomePreview();
        uploadFilename.textContent = `${file.name} — caricata`;
        uploadButton.textContent = "Foto caricata";
        fileInput.value = "";
      } catch (error) {
        uploadFilename.textContent = "Caricamento non riuscito";
        alert(`Errore caricamento immagine: ${error.message}`);
        uploadButton.textContent = originalButtonText;
      } finally {
        uploadButton.disabled = false;
      }
    });

    updateHomePreview();
    container.appendChild(row);
  });
}

