function homeImageUrl(key) {
  if (!key) return "";

  const value = String(key).trim();

  if (/^https?:\/\//i.test(value)) return value;

  if (value.startsWith("assets/")) return `../${value}`;

  return `${API}/api/images/${encodeURIComponent(value)}`;
}

