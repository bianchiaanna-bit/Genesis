});

/* =====================================================
   CARICAMENTO GENERALE
   Una sezione non deve impedire il caricamento delle altre.
   ===================================================== */

async function loadEverything() {
  const tasks = [
    { run: loadMenu, status: "dishes-status", label: "Menu" },
    { run: loadMenuInfo, status: "extras-status", label: "Extras e allergeni" },
    { run: loadHomeDishes, status: "home-dishes-status", label: "Piatti in homepage" },
    { run: loadPopups, status: "popups-status", label: "Pop-up" },
    { run: loadHours, status: "hours-status", label: "Orari" }
  ];

  const results = await Promise.allSettled(
    tasks.map(task => task.run())
  );

  const failures = [];

  results.forEach((result, index) => {
    if (result.status !== "rejected") return;

    const task = tasks[index];
    const message = result.reason?.message || "Errore di caricamento.";

    failures.push(`${task.label}: ${message}`);

    const status = document.getElementById(task.status);
    if (status) showStatus(status, message, "error");
  });

  if (failures.length) {
    console.error("Caricamento dashboard incompleto:", failures);
  }
}

